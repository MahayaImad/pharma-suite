# Copier en .env (jamais versionné) et renseigner les mots de passe.
POSTGRES_DB=pharmasuite_db
POSTGRES_USER=pharmasuite_user
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=admin@pharmasuite.local
PGADMIN_DEFAULT_PASSWORD=

# API
API_PORT=8000
# Clé de signature JWT : générer avec   openssl rand -hex 32
SECRET_KEY=
# Mot de passe du compte sync_agent ; le même que [api] password dans
# agent-easypharm/config.toml sur le PC EASYPHARM.
SYNC_AGENT_PASSWORD=
ANTHROPIC_API_KEY=
